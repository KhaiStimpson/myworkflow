{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-state.sh"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/guard-image-read.sh"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/phase-boundary.sh"
            ]
          },
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/context-budget.sh"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/write-handoff-spine.sh"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/write-handoff-spine.sh"
            ]
          }
        ]
      }
    ]
  }
}
